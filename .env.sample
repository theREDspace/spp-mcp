# ---------------------------------------------------------------------------
# SPP MCP Server configuration
#
# Validated at startup by the Zod schema in src/config.ts. The server refuses to
# boot and lists every problem if something is missing or malformed.
#
# See README.md#configuration for the full table with defaults.
# ---------------------------------------------------------------------------

# ---- Required ----

# SuiteProjects Pro instance URL.
SPP_URL=https://redspace-sbx.app.sandbox.netsuitesuiteprojectspro.com

# OAuth2 credentials from your SPP API Integration app.
# SPP_CLIENT_SECRET never leaves this server — MCP clients get proxy credentials.
SPP_CLIENT_ID=
SPP_CLIENT_SECRET=

# OAuth callback. Must match the redirect_uri registered in the SPP app EXACTLY.
# A mismatch here is the most common cause of OAuth loops.
SPP_CALLBACK_URL=https://drearily-anime-wrench.ngrok-free.dev/callback/spp

# SPP XML API credentials. If these are wrong you get empty or malformed
# responses rather than a clear error — check them first when XML looks broken.
SPP_NAMESPACE=
SPP_KEY=

# ---- Strongly recommended ----

# Public URL of this server. Used in all /.well-known metadata, and it is the
# default source for ALLOWED_ORIGIN_HOSTS below. Defaults to http://localhost:3030.
APP_BASE_URL=https://drearily-anime-wrench.ngrok-free.dev

# development | test | production. Default: development.
# production excludes the `echo` debug tool and enables the TRUST_PROXY default.
NODE_ENV=development

# Gates POST /oauth/register. Minimum 8 characters. Callers must then send:
#   Authorization: Bearer <value>
#
# Leaving this unset does NOT expose SPP_CLIENT_ID/SECRET — DCR issues per-client
# proxy credentials specifically so the SPP secret never leaves this server. The
# real risk is that ANY caller can mint valid proxy client credentials, which is
# step one of several authorization-code interception chains. Treat "unset" as
# development-only, not merely "fine on a private network".
# REGISTRATION_SECRET=

# ---- Optional ----

# HTTP listen port. Default: 3030.
# PORT=3030

# Fallback for /callback/spp when the `state` entry is gone (e.g. after a restart).
# Relays SPP ERROR responses only — never an authorization code.
SPP_FORWARD_CALLBACK_URL=http://localhost:6274/oauth/callback

# Required in production behind a reverse proxy (nginx, ALB, etc.).
# Tells Express to trust X-Forwarded-For / X-Forwarded-Proto.
# '1' trusts one hop; increase for multiple proxy layers.
# Defaults to '1' when NODE_ENV=production and this is unset.
TRUST_PROXY=1

# MCP protocol era control: serve | reject. Default: serve.
# `serve` keeps pre-2026-07-28 clients working alongside modern ones. Flip to
# `reject` only once logs show no "[MCP] serving legacy-era request" lines.
# MCP_LEGACY=serve

# Comma-separated hostnames (no scheme, no port) allowed in the Origin header on
# /mcp — MCP's DNS-rebinding protection. Defaults to APP_BASE_URL's host, so the
# protection is ON by default. Non-browser MCP clients send no Origin and always
# pass; set this only if a browser-based client is served from another origin.
# ALLOWED_ORIGIN_HOSTS=

# Comma-separated hostname allowlist for Client ID Metadata Document fetches.
# Unset allows any https host. Private, loopback, link-local, CGNAT and NAT64
# ranges are blocked regardless of this setting.
# CIMD_ALLOWED_HOSTS=

# Comma-separated allowed CORS origins. Unset reflects any origin.
# CORS_ORIGINS=

# Requests per minute per IP on /oauth/* and /callback/spp. Default: 30.
# OAUTH_RATE_LIMIT_PER_MIN=30

# Path to the DCR client registry. Default: data/clients.json.
# RESOLVED RELATIVE TO THE PROCESS WORKING DIRECTORY — the process must start
# with cwd at the repo root. Losing this file means every client must re-register.
# CLIENT_REGISTRY_PATH=data/clients.json

# ---- Known wart ----

# Adds a mutex_id to Timesheet creation for idempotency.
#
# WARNING: this is read directly from process.env in
# src/mcp/helpers/timesheetResolver.ts as a TRUTHY STRING CHECK, not a boolean —
# it is not in src/config.ts and is neither validated nor parsed. The string
# "FALSE" is truthy, so MUTEX_ID_ENABLED=FALSE ENABLES the feature, exactly like
# TRUE. The only ways to disable it are to leave it unset or set it empty.
#
# Recommended: leave it set to TRUE, so the value matches the behavior.
MUTEX_ID_ENABLED=TRUE
